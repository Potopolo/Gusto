{
  "name": "nutrition",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local src/lib/server/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.local src/lib/server/db/seed.ts",
    "db:reset": "rimraf data/local.db && npm run db:migrate && npm run db:seed",
    "scrape:amandine": "tsx --env-file=.env.local src/lib/server/scraper/run.ts",
    "import:ciqual": "tsx --env-file=.env.local src/lib/server/ciqual/import.ts",
    "rematch": "tsx --env-file=.env.local src/lib/server/ciqual/rematch.ts",
    "compute:nutrition": "tsx --env-file=.env.local src/lib/server/ciqual/compute.ts",
    "reparse": "tsx --env-file=.env.local src/lib/server/scraper/reparse.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.36.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^4.7.4",
    "@sveltejs/kit": "^2.8.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.1",
    "@tailwindcss/forms": "^0.5.9",
    "@types/node": "^22.9.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "svelte": "^5.1.16",
    "svelte-check": "^4.0.8",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
