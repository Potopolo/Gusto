# Local development: file-backed SQLite
LIBSQL_URL=file:./data/local.db

# Production (Cloudflare Pages + Turso):
# LIBSQL_URL=libsql://<your-db>.turso.io
# LIBSQL_AUTH_TOKEN=<turso-auth-token>

# Shared household password — change this
HOUSEHOLD_PASSWORD=change-me

# HMAC secret for signing the session cookie — any long random string
SESSION_SECRET=replace-with-a-long-random-string
